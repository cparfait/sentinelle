SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///admin_dashboard.db

# Office 365 SMTP Configuration
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@yourdomain.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@yourdomain.com

ADMIN_EMAIL=your-email@yourdomain.com
ALERT_RECIPIENTS=your-email@yourdomain.com,backup-team@yourdomain.com

APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=false

# Securite
SESSION_LIFETIME_MINUTES=480
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Mettre a true une fois l'app servie en HTTPS (cookie de session Secure).
SESSION_COOKIE_SECURE=false
# Mettre a true pour imposer la double authentification aux comptes admin.
REQUIRE_2FA_ADMIN=false

# Authentification LDAP / Active Directory (cohabite avec les comptes locaux)
LDAP_ENABLED=false
LDAP_SERVER=ldap://dc.chatillon.lan
LDAP_PORT=389
LDAP_USE_SSL=false
# LDAPS : valider le certificat serveur (mettre false si CA interne/auto-signe), CA optionnelle
LDAP_VALIDATE_CERT=true
LDAP_CA_CERT=
LDAP_DOMAIN=chatillon.lan
LDAP_BASE_DN=DC=chatillon,DC=lan
LDAP_DEFAULT_ROLE=viewer
# Compte de service (lecture seule) pour la synchro d'expiration des mots de passe AD
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# URL publique de l'app (pour les liens dans les emails)
APP_BASE_URL=http://sentinelle.votredomaine.lan:5000

# Notifications par webhook (optionnel, en plus du mail). Laisser vide pour desactiver.
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Surveillance Certificate Transparency (crt.sh) : detecte les certificats emis
# pour vos domaines a l'insu de la DSI. Scan quotidien (06h30). true / false.
CT_MONITORING=true

# Integration Sesame : API GET /api/assets (liste des applications) securisee par
# une cle (Authorization: Bearer). Gerer de preference depuis Preferences (cle
# chiffree en base). Repli .env ci-dessous. Laisser desactive par defaut.
SESAME_API_ENABLED=false
SESAME_API_TOKEN=

# Jeton secret pour l'ingestion des mails recap de backup (POST /backups/ingest)
# Generer: python -c "import secrets; print(secrets.token_urlsafe(24))"
BACKUP_INGEST_TOKEN=

# Repertoire ou sont deposes les mails recap de backup (.eml/.txt/.html).
# Sentinelle le scanne toutes les 30 min et archive les fichiers dans 'traites'.
BACKUP_INBOX_DIR=

# Auto-sauvegarde de la base SQLite (quotidienne 01h00).
# Repertoire (vide = <instance>/db_backups) et nombre de copies conservees.
BACKUP_DB_DIR=
BACKUP_DB_KEEP=14
