SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///admin_dashboard.db

# Office 365 SMTP Configuration
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@yourdomain.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@yourdomain.com

ADMIN_EMAIL=your-email@yourdomain.com
ALERT_RECIPIENTS=your-email@yourdomain.com,backup-team@yourdomain.com

APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=false

# URL publique de l'app (pour les liens dans les emails)
APP_BASE_URL=http://sentinelle.votredomaine.lan:5000

# Jeton secret pour l'ingestion des mails recap de backup (POST /backups/ingest)
# Generer: python -c "import secrets; print(secrets.token_urlsafe(24))"
BACKUP_INGEST_TOKEN=

# Repertoire ou sont deposes les mails recap de backup (.eml/.txt/.html).
# Sentinelle le scanne toutes les 30 min et archive les fichiers dans 'traites'.
BACKUP_INBOX_DIR=
